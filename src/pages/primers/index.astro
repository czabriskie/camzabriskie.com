---
import Base from '../../layouts/Base.astro';
import NoteList from '../../components/NoteList.astro';
import { publishedTopics } from '../../lib/primers';

const groups = await publishedTopics();
const blurb =
  "Explainers for things I've had to learn, written so someone else can pick them up too. These get revised as I understand more, unlike the posts.";
---
<Base title="Primers — Cam Zabriskie" description={blurb}>
  <div class="primers stream-tech">
    <div class="stream-head">
      <span class="tick" aria-hidden="true"></span>
      <h1>Primers</h1>
    </div>
    <p class="lede" style="color: var(--muted); margin-bottom: 2.5rem;">{blurb}</p>

    {groups.map(({ topic, notes }) => (
      <section class="group">
        <div class="group-head">
          <h2><a href={`/primers/${topic.slug}/`}>{topic.title}</a></h2>
          <span class="mono count">{notes.length} {notes.length === 1 ? 'note' : 'notes'}</span>
        </div>
        <p class="group-note">{topic.blurb}</p>
        <NoteList notes={notes} />
      </section>
    ))}
  </div>
</Base>
