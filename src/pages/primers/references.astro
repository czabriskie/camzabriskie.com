---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { references, formatReference } from '../../data/references.mjs';
import { noteUrl, type Note } from '../../lib/primers';
import { findCitations } from '../../lib/citation-keys.mjs';

// Every source cited by any published primer, with links back to the primers citing it.
const notes = (await getCollection('primers', (n) => !n.data.draft)).sort((a, b) => a.id.localeCompare(b.id));
const citedBy = new Map<string, Note[]>();
for (const note of notes) {
  const keys = new Set(findCitations(note.body ?? '').cites.map((c) => c.key).filter((k) => k in references));
  for (const key of keys) citedBy.set(key, [...(citedBy.get(key) ?? []), note]);
}
const sortKey = (key: string) => {
  const r = (references as Record<string, any>)[key];
  // Organizations sort by name, people by the first author's surname.
  const who = typeof r.authors === 'string' ? r.authors : r.authors[0].replace(/,? Ed\.$/, '').replace(/,? (Jr\.|Sr\.|\d+(st|nd|rd|th))$/, '').split(' ').pop();
  return `${who} ${r.title}`.toLowerCase();
};
const keys = [...citedBy.keys()].sort((a, b) => sortKey(a).localeCompare(sortKey(b)));
const blurb = 'Every source the primers cite, in one place, with links back to the primers that use each one.';
---
<Base title="References — Primers — Cam Zabriskie" description={blurb}>
  <div class="primers stream-tech">
    <p class="crumbs mono"><a href="/primers/">Primers</a></p>
    <div class="stream-head">
      <span class="tick" aria-hidden="true"></span>
      <h1>References</h1>
    </div>
    <p class="lede" style="color: var(--muted); margin-bottom: 2rem;">
      {blurb} Each primer also lists its own sources at the bottom, numbered in the order it cites them.
    </p>
    <ul class="references all">
      {keys.map((key) => (
        <li id={key}>
          <span set:html={formatReference((references as Record<string, any>)[key])} />
          <span class="cited-in mono">
            Cited in: {citedBy.get(key)!.map((n, i) => <>{i > 0 && ', '}<a href={noteUrl(n)}>{n.data.title}</a></>)}
          </span>
        </li>
      ))}
    </ul>
  </div>
</Base>
