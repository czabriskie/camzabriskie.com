---
import Base from '../../../layouts/Base.astro';
import NoteList from '../../../components/NoteList.astro';
import { publishedTopics, sectionedNotes, noteUrl, pos } from '../../../lib/primers';

export async function getStaticPaths() {
  return (await publishedTopics()).map(({ topic, notes }) => ({ params: { topic: topic.slug }, props: { topic, notes } }));
}

const { topic, notes } = Astro.props;
const groups = sectionedNotes(topic.slug, notes);
---
<Base title={`${topic.title} — Primers — Cam Zabriskie`} description={topic.blurb}>
  <div class="primers stream-tech">
    <p class="crumbs mono"><a href="/primers/">Primers</a></p>
    <div class="stream-head">
      <span class="tick" aria-hidden="true"></span>
      <h1>{topic.title}</h1>
    </div>
    <p class="lede" style="color: var(--muted); margin-bottom: 2rem;">{topic.blurb}</p>
    {notes.length > 1 && (
      <p class="start-here"><span class="mono start-tag">Start here</span> <a href={noteUrl(notes[0])}><span class="mono">{pos(0)}</span> {notes[0].data.title}</a>, then read in order.</p>
    )}
    {groups.length > 1 && (
      <nav class="section-jump mono" aria-label="Sections">
        {groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
      </nav>
    )}
    {groups.map((g) =>
      g.title ? (
        <section class="topic-section" id={g.id}>
          <h2 class="section-title">{g.title}</h2>
          {g.blurb && <p class="section-blurb">{g.blurb}</p>}
          <NoteList notes={g.notes} all={notes} />
        </section>
      ) : (
        <NoteList notes={g.notes} />
      ),
    )}
  </div>
</Base>
