---
import Base from '../layouts/Base.astro';
const skills = [
  'AWS', 'Kubernetes / EKS', 'Terraform', 'Helm', 'ArgoCD', 'Karpenter', 'KEDA',
  'GitLab CI', 'Docker', 'Prometheus / Grafana', 'k6', 'Python', 'AWS CDK', 'Lambda',
  'ECS', 'SQL', 'Snowflake', 'scikit-learn', 'pandas', 'Flask', 'pytest', 'R', 'Git', 'Linux',
];
---
<Base title="Resume — Cam Zabriskie" description="Cameron Zabriskie — senior DevOps engineer. Resume.">
  <div class="resume">
    <h1>Cameron Zabriskie</h1>
    <p class="lede" style="color: var(--muted);">
      Senior DevOps engineer ·
      <a href="mailto:cameron.zabriskie@gmail.com">cameron.zabriskie@gmail.com</a> ·
      <a href="https://www.linkedin.com/in/cameron-zabriskie">LinkedIn</a> ·
      <a href="https://github.com/czabriskie">github.com/czabriskie</a>
    </p>

    <section>
      <h2>Experience</h2>

      <div class="role">
        <h3>Senior DevOps Engineer</h3>
        <span class="when mono">2024 – present</span>
      </div>
      <p class="org">ZONTAL · Provo, UT</p>
      <ul>
        <li>Migrated the company's public website from an external agency to self-hosted Cloudflare Pages with edge-native services — authored the architecture design, designed the GitHub Actions CI/CD pipeline, hardened security (WAF, CSP, HSTS), and managed the DNS cutover.</li>
        <li>Established the organization's first SLIs/SLOs for platform applications — profiled production services with custom instrumentation and k6 load tests, uncovering a confirmed memory leak and CPU-bound rendering bottlenecks, and authored the platform ADR of prioritized fixes now adopted as the applications team's reliability baseline.</li>
        <li>Designed and prototyped Kubernetes autoscaling (Karpenter + KEDA) for ~15 first-party applications, moving them off fixed-replica node groups onto demand-driven infrastructure — including a Redis-backed session-count metric that combines with CPU signals to catch blind spots either signal misses alone, validated end-to-end with a synchronized Playwright + k6 harness.</li>
        <li>Found and quantified major AWS cost leaks: an audit across two regions showing 82% of load-balancer target groups (3,170 of 3,876) were orphaned, and a root-cause diagnosis of an Elastic IP leak from mismatched Lambda/SQS/NAT timeouts, with self-healing fixes designed for both.</li>
        <li>Building the SRE practice from the ground up: designed a unified observability and alerting architecture consolidating three disconnected alerting paths, positioned as groundwork for SOC 2 and customer scale.</li>
        <li>Centralized environment deployment configuration in Git (Helm, ArgoCD, GitLab CI) and coordinated the application-deployment workstream for a major platform upgrade across multiple enterprise customer environments, standardizing previously inconsistent per-customer deployments.</li>
      </ul>

      <div class="role">
        <h3>Senior Software Engineer</h3>
        <span class="when mono">May 2023 – 2024</span>
      </div>
      <p class="org">ZONTAL · Provo, UT</p>
      <ul>
        <li>Developed parsers and viewer applications for scientific instrument data — mass spectrometry, chromatography, plate readers, flow cytometry, and qPCR — on a life-sciences data platform.</li>
        <li>Worked directly with pharma and biotech customers and subject-matter experts to drive projects toward real customer impact.</li>
        <li>Managed software releases and documentation, and drove development-process improvements that raised team velocity.</li>
      </ul>

      <div class="role">
        <h3>ML / Data Engineer</h3>
        <span class="when mono">Apr 2022 – May 2023</span>
      </div>
      <p class="org">Biolexis Therapeutics · American Fork, UT</p>
      <ul>
        <li>Built the company's CI/CD pipeline (JetBrains Space, Docker, AWS) deploying to Lambda, ECS Fargate, and S3, and converted all manual AWS deployments to infrastructure-as-code with AWS CDK.</li>
        <li>Integrated Anyscale for distributed processing jobs, cutting runtimes from weeks to under a day.</li>
        <li>Built APIs and ELT pipelines serving graph, relational, and NoSQL data; supported small-molecule docking and molecular-dynamics applications (AutoDock, ICM, Gold, PyRosetta, OpenMM).</li>
      </ul>

      <div class="role">
        <h3>Data Scientist / ML Engineer</h3>
        <span class="when mono">Jan 2019 – Apr 2022</span>
      </div>
      <p class="org">Progrexion · Salt Lake City, UT</p>
      <ul>
        <li>Developed a survival-analysis model predicting subscription-cancellation hazard, guiding retention resources and quantifying turnover.</li>
        <li>Built and deployed a gradient-boosting model (Heroku) prioritizing negative credit items per client for the credit-repair systems.</li>
        <li>Built an HR data warehouse and near-real-time reporting system on MS SQL Server, SharePoint, and SSRS.</li>
      </ul>

      <div class="role">
        <h3>Data Science Adjunct Professor</h3>
        <span class="when mono">Aug 2020 – May 2022</span>
      </div>
      <p class="org">Brigham Young University · Provo, UT</p>
      <ul>
        <li>Developed and taught a course on deploying data-science applications: Git, Docker, scikit-learn, pytest, Flask, AWS Elastic Beanstalk.</li>
        <li>Mentored students building data-science solutions with local businesses.</li>
      </ul>
    </section>

    <section>
      <h2>Education</h2>
      <div class="role">
        <h3>MS, Data Analytics</h3>
        <span class="when mono">2018</span>
      </div>
      <p class="org">Utah State University</p>
      <div class="role">
        <h3>BS, Biological Engineering · Computer Science minor</h3>
        <span class="when mono">2017</span>
      </div>
      <p class="org">Utah State University</p>
    </section>

    <section>
      <h2>Skills</h2>
      <ul class="skills">
        {skills.map((s) => <li>{s}</li>)}
      </ul>
    </section>
  </div>
</Base>
